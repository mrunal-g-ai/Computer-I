# Experiment 4: K-Means Clustering on Iris Dataset using Elbow Method
#%pip install --upgrade threadpoolctl scikit-learn
# 1. Import Libraries
import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.datasets import load_iris
from sklearn.cluster import KMeans

# 2. Load Dataset
if os.path.exists("Iris.csv"):
    df = pd.read_csv("Iris.csv").drop(columns=["Id"], errors="ignore")
    X = df.iloc[:, :4].values
    species = df["Species"]
    print("Data source: Iris.csv")
else:
    iris = load_iris(as_frame=True)
    X = iris.data.values
    species = pd.Series(iris.target_names[iris.target], name="Species")
    print("Data source: Scikit-learn built-in Iris dataset")

print("\nDataset Shape:", X.shape)

# 3. Elbow Method (WCSS for K = 1 to 10)
wcss = []

for k in range(1, 11):
    km = KMeans(n_clusters=k, init="k-means++", n_init=10, random_state=42)
    km.fit(X)
    wcss.append(km.inertia_)
    print(f"K = {k:2d}  WCSS = {km.inertia_:8.2f}")

# 4. Plot Elbow Graph
plt.figure(figsize=(7, 4.5))
plt.plot(range(1, 11), wcss, marker="o")
plt.annotate(
    "Elbow point (K = 3)",
    xy=(3, wcss[2]),
    xytext=(4.5, wcss[2] + 120),
    arrowprops=dict(arrowstyle="->")
)
plt.xlabel("Number of Clusters")
plt.ylabel("WCSS")
plt.title("Elbow Method")
plt.grid(alpha=0.3)
plt.show()

# 5. Apply K-Means Clustering with K = 3
K = 3
kmeans = KMeans(n_clusters=K, init="k-means++", n_init=10, random_state=42)
labels = kmeans.fit_predict(X)

print("\nChosen K:", K)
print("Cluster Sizes:", np.bincount(labels))

print("\nCluster Centroids:")
print(kmeans.cluster_centers_.round(3))

# 6. Compare Clusters with Actual Species
print("\nClusters vs Actual Species:")
print(pd.crosstab(species, labels, rownames=["Species"], colnames=["Cluster"]))

# 7. Visualize Clusters
plt.figure(figsize=(7, 5))

for c in range(K):
    plt.scatter(X[labels == c, 2], X[labels == c, 3], label=f"Cluster {c}")

plt.scatter(
    kmeans.cluster_centers_[:, 2],
    kmeans.cluster_centers_[:, 3],
    s=200, c="black", marker="X", label="Centroids"
)

plt.xlabel("Petal Length (cm)")
plt.ylabel("Petal Width (cm)")
plt.title("K-Means Clusters (K = 3)")
plt.legend()
plt.grid(alpha=0.3)
plt.show()


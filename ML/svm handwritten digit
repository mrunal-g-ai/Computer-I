# Experiment 3: SVM for Handwritten Digit Classification (0-9)

# 1. Import Libraries
import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.datasets import load_digits
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.svm import SVC
from sklearn import metrics

# 2. Load Dataset
if os.path.exists("train.csv"):
    train_df = pd.read_csv("train.csv", nrows=10000)
    X = train_df.drop("label", axis=1)
    y = train_df["label"]
    print("Data source: train.csv")
else:
    d = load_digits(as_frame=True)
    X, y = d.data, d.target
    print("Data source: Scikit-learn built-in digits dataset (8x8 images)")

side = int(np.sqrt(X.shape[1]))

print("\nSamples:", X.shape[0], "| Features:", X.shape[1],
      f"(Image {side}x{side})")
print("Class counts:\n", y.value_counts().sort_index().to_dict())

# 3. Train-Test Split
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=100
)

# 4. Feature Scaling
scaler = StandardScaler()
X_train = scaler.fit_transform(X_train)
X_test = scaler.transform(X_test)

# 5. Train Linear and RBF SVM Models
lin_model = SVC(kernel="linear").fit(X_train, y_train)
rbf_model = SVC(kernel="rbf").fit(X_train, y_train)

y_rbf_pred = rbf_model.predict(X_test)

acc_lin = metrics.accuracy_score(y_test, lin_model.predict(X_test))
acc_rbf = metrics.accuracy_score(y_test, y_rbf_pred)

# 6. Compare Predicted and Actual Values
print("\nPredicted values:\n", y_rbf_pred[10:15])
print("Actual values:\n", y_test.iloc[10:15].values)

# 7. Model Evaluation
print("\nLinear Kernel Accuracy: {:.2f}%".format(acc_lin * 100))
print("RBF Kernel Accuracy: {:.2f}%".format(acc_rbf * 100))

print("\nClassification Report (RBF):\n")
print(metrics.classification_report(y_test, y_rbf_pred))

# 8. Display Test Images with Predicted Labels
np.random.seed(1)
fig, axes = plt.subplots(1, 4, figsize=(10, 3))

for ax, i in zip(axes, np.random.randint(0, len(X_test), 4)):
    img = scaler.inverse_transform(X_test[i:i+1]).reshape(side, side)
    ax.imshow(img, cmap="gray")
    ax.set_title(f"Predicted: {y_rbf_pred[i]}")
    ax.axis("off")

plt.tight_layout()
plt.show()

# Experiment Result
print("\nExperiment 3 Completed Successfully!")
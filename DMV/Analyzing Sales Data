# 1. Import Libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# 2. Create Sample Sales Data
data = {
    "Order_ID": [101, 102, 103, 104, 105, 106, 107, 108, 109, 110],
    "Product": ["Laptop", "Mobile", "Chair", "Table", "Laptop",
                "Mobile", "Headphones", "Chair", "Table", "Laptop"],
    "Category": ["Electronics", "Electronics", "Furniture", "Furniture",
                 "Electronics", "Electronics", "Electronics", "Furniture",
                 "Furniture", "Electronics"],
    "Quantity": [2, 3, 4, 2, 1, 5, 3, 2, 4, 1],
    "Price": [50000, 20000, 5000, 8000, 50000,
              20000, 3000, 5000, 8000, 50000]
}

df = pd.DataFrame(data)
print("Original Sales Data:\n", df)

# 3. Save Data in CSV, Excel and JSON
df.to_csv("sales_data.csv", index=False)
df.to_excel("sales_data.xlsx", index=False)
df.to_json("sales_data.json", orient="records", indent=4)
print("\nFiles created successfully!")

# 4. Load Data from All Three Formats
csv_data = pd.read_csv("sales_data.csv")
excel_data = pd.read_excel("sales_data.xlsx")
json_data = pd.read_json("sales_data.json")

print("\nCSV Data:\n", csv_data.head())
print("\nExcel Data:\n", excel_data.head())
print("\nJSON Data:\n", json_data.head())

# 5. Explore Dataset
print("\nDataset Shape:", csv_data.shape)
print("\nColumn Names:", csv_data.columns.tolist())
print("\nData Types:\n", csv_data.dtypes)
print("\nDataset Information:")
csv_data.info()
print("\nStatistical Summary:\n", csv_data.describe())

# 6. Check Missing Values and Duplicates
print("\nMissing Values:\n", csv_data.isnull().sum())
print("\nDuplicate Records:", csv_data.duplicated().sum())

# 7. Remove Duplicates and Handle Missing Values
csv_data = csv_data.drop_duplicates()
csv_data["Quantity"] = csv_data["Quantity"].fillna(csv_data["Quantity"].median())
csv_data["Price"] = csv_data["Price"].fillna(csv_data["Price"].median())
csv_data["Category"] = csv_data["Category"].fillna("Unknown")

print("\nDuplicates removed and missing values handled.")
print("Number of records:", len(csv_data))

# 8. Standardize Column Names and Convert Data Types
def clean_data(data):
    data = data.copy()
    data.columns = (data.columns.str.strip()
                    .str.replace(" ", "_").str.lower())

    data["quantity"] = pd.to_numeric(data["quantity"], errors="coerce")
    data["price"] = pd.to_numeric(data["price"], errors="coerce")
    data["total_sales"] = data["quantity"] * data["price"]

    return data

csv_data = clean_data(csv_data)
excel_data = clean_data(excel_data)
json_data = clean_data(json_data)

print("\nStandardized Columns:", csv_data.columns.tolist())
print("\nUpdated Data Types:\n", csv_data.dtypes)

# 9. Add Source Information
csv_data["source"] = "CSV"
excel_data["source"] = "Excel"
json_data["source"] = "JSON"

# 10. Combine All Datasets
unified_data = pd.concat(
    [csv_data, excel_data, json_data],
    ignore_index=True
)

print("\nUnified Data:\n", unified_data.head())
print("\nUnified Shape:", unified_data.shape)

# 11. Remove Duplicate Orders
unified_data = unified_data.drop_duplicates(subset=["order_id"])

print("\nFinal Unified Dataset:\n", unified_data)

# 12. Calculate Total Sales and Average Order Value
total_sales = unified_data["total_sales"].sum()
average_order_value = unified_data["total_sales"].mean()

print("\nTotal Sales =", total_sales)
print("Average Order Value =", average_order_value)

# 13. Category-wise and Product-wise Sales
category_sales = unified_data.groupby("category")["total_sales"].sum()
product_sales = unified_data.groupby("product")["total_sales"].sum().sort_values(ascending=False)

print("\nCategory-wise Sales:\n", category_sales)
print("\nProduct-wise Sales:\n", product_sales)

# 14. Descriptive Statistics
print("\nDescriptive Statistics:\n", unified_data.describe())

# 15. Bar Plot - Category-wise Sales
category_sales.plot(kind="bar", figsize=(8, 5))
plt.title("Category-wise Total Sales")
plt.xlabel("Category")
plt.ylabel("Total Sales")
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()

# 16. Pie Chart - Category Distribution
category_counts = unified_data["category"].value_counts()

plt.figure(figsize=(7, 7))
plt.pie(category_counts, labels=category_counts.index, autopct="%1.1f%%")
plt.title("Product Category Distribution")
plt.show()

# 17. Box Plot - Sales Distribution
plt.figure(figsize=(8, 5))
sns.boxplot(x=unified_data["total_sales"])
plt.title("Distribution of Total Sales")
plt.xlabel("Total Sales")
plt.show()

# 18. Final Results
print("\nFinal Cleaned Sales Dataset:\n", unified_data)
print("\nTotal Sales:", unified_data["total_sales"].sum())
print("Average Order Value:", unified_data["total_sales"].mean())
print("\nCategory-wise Sales:")
print(unified_data.groupby("category")["total_sales"].sum())

print("\nExperiment 1 Completed Successfully!")
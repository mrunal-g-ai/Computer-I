
# EXPERIMENT 6: DATA AGGREGATION
# Analyzing Sales Performance by Region in a Retail Company

# 1. Import Libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# 2. Import Dataset Directly from Online URL
DATA_URL = "https://raw.githubusercontent.com/nawaz62/retail-sales-analysis/main/retail_sales_raw.csv"

df = pd.read_csv(DATA_URL)
print("Dataset loaded successfully!")
print(df.head())

# 3. Explore Dataset
print("\nDataset Shape:", df.shape)
print("\nColumn Names:", df.columns.tolist())

print("\nDataset Information:")
df.info()

print("\nStatistical Summary:\n", df.describe(include="all"))

# 4. Clean Column Names
df.columns = (
    df.columns.str.strip()
    .str.lower()
    .str.replace(r"[^a-zA-Z0-9]+", "_", regex=True)
    .str.strip("_")
)

# Rename columns to match the practical
df.rename(columns={
    "category": "product_category",
    "sales": "sales_amount",
    "order_date": "transaction_date"
}, inplace=True)

print("\nCleaned Column Names:")
print(df.columns.tolist())

# 5. Check Missing Values
print("\nMissing Values:\n", df.isnull().sum())

required_columns = [
    "region", "product_category", "sales_amount"
]

missing_columns = [
    col for col in required_columns if col not in df.columns
]

if missing_columns:
    raise ValueError("Required columns missing: " + str(missing_columns))

df = df.dropna(subset=required_columns)

print("\nDataset Shape After Cleaning:", df.shape)

# 6. Remove Duplicate Records
print("\nDuplicate Records:", df.duplicated().sum())

df.drop_duplicates(inplace=True)

print("Shape After Removing Duplicates:", df.shape)

# 7. Convert Sales Amount to Numeric
df["sales_amount"] = pd.to_numeric(
    df["sales_amount"].astype(str).str.replace(",", ""),
    errors="coerce"
)

df.dropna(subset=["sales_amount"], inplace=True)

print("\nCleaned Sales Data:\n", df.head())

# 8. Explore Relevant Variables
print("\nRegions:")
print(df["region"].unique())

print("\nProduct Categories:")
print(df["product_category"].unique())

print("\nTotal Transactions:", len(df))

# 9. Total Sales by Region
regional_sales = (
    df.groupby("region")["sales_amount"]
    .sum()
    .sort_values(ascending=False)
)

print("\nTotal Sales by Region:")
print(regional_sales)

# 10. Additional Regional Statistics
regional_summary = (
    df.groupby("region")["sales_amount"]
    .agg(
        total_sales="sum",
        average_sales="mean",
        minimum_sales="min",
        maximum_sales="max",
        transaction_count="count"
    )
)

print("\nRegional Sales Summary:")
print(regional_summary)

# 11. Bar Plot - Sales by Region
plt.figure(figsize=(10, 6))

regional_sales.plot(kind="bar")

plt.title("Total Sales by Region")
plt.xlabel("Region")
plt.ylabel("Total Sales Amount")
plt.xticks(rotation=0)
plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()

# 12. Pie Chart - Regional Sales Distribution
plt.figure(figsize=(8, 8))

plt.pie(
    regional_sales.values,
    labels=regional_sales.index,
    autopct="%1.1f%%",
    startangle=90
)

plt.title("Sales Distribution by Region")
plt.show()

# 13. Identify Top Performing Region
top_region = regional_sales.idxmax()
top_sales = regional_sales.max()

print("\nTop Performing Region:", top_region)
print("Total Sales:", round(top_sales, 2))

# 14. Find Top 3 Regions
top_3_regions = regional_sales.head(3)

print("\nTop 3 Performing Regions:")
print(top_3_regions)

# 15. Sales by Region and Product Category
region_category_sales = (
    df.groupby(["region", "product_category"])["sales_amount"]
    .sum()
)

print("\nSales by Region and Product Category:")
print(region_category_sales)

# 16. Convert to Pivot Table
sales_pivot = df.pivot_table(
    index="region",
    columns="product_category",
    values="sales_amount",
    aggfunc="sum",
    fill_value=0
)

print("\nSales Pivot Table:")
print(sales_pivot)

# 17. Stacked Bar Plot
sales_pivot.plot(
    kind="bar",
    stacked=True,
    figsize=(12, 7)
)

plt.title("Sales by Region and Product Category")
plt.xlabel("Region")
plt.ylabel("Total Sales Amount")
plt.xticks(rotation=0)
plt.legend(title="Product Category")
plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()

# 18. Grouped Bar Plot
sales_pivot.plot(
    kind="bar",
    figsize=(12, 7)
)

plt.title("Comparison of Sales by Region and Product Category")
plt.xlabel("Region")
plt.ylabel("Total Sales Amount")
plt.xticks(rotation=0)
plt.legend(title="Product Category")
plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()

# 19. Total Sales by Product Category
category_sales = (
    df.groupby("product_category")["sales_amount"]
    .sum()
    .sort_values(ascending=False)
)

print("\nTotal Sales by Product Category:")
print(category_sales)

plt.figure(figsize=(10, 6))

category_sales.plot(kind="bar")

plt.title("Total Sales by Product Category")
plt.xlabel("Product Category")
plt.ylabel("Total Sales Amount")
plt.xticks(rotation=45)
plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()

# 20. Percentage Contribution of Each Region
regional_percentage = (
    regional_sales / regional_sales.sum()
) * 100

print("\nRegional Sales Contribution (%):")
print(regional_percentage.round(2))

# 21. Overall Sales Statistics
total_sales = df["sales_amount"].sum()
average_sales = df["sales_amount"].mean()
maximum_sale = df["sales_amount"].max()
minimum_sale = df["sales_amount"].min()

print("\nOverall Sales Statistics:")
print("Total Sales:", round(total_sales, 2))
print("Average Transaction Sales:", round(average_sales, 2))
print("Maximum Transaction:", round(maximum_sale, 2))
print("Minimum Transaction:", round(minimum_sale, 2))

# 22. Export Aggregated Results
regional_summary.to_csv("Regional_Sales_Summary.csv")
sales_pivot.to_csv("Regional_Category_Sales.csv")

print("\nAggregated Datasets Exported Successfully!")
print("EXPERIMENT 6 COMPLETED SUCCESSFULLY!")
